// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  username   String?   @unique
  email      String    @unique
  phone      String?   @unique
  password   String
  roleId     Int
  schoolId   Int?
  isActive   Boolean   @default(true)
  image      String?
  gender     String?
  dob        DateTime?
  address    String?
  createdAt  DateTime  @default(now())

  role       Role      @relation(fields: [roleId], references: [id])
  school     School?   @relation(fields: [schoolId], references: [id])

  student          Student?
  teacher          Teacher?
  parent           Parent?
  principal        Principal?
  accountant       Accountant?
  librarian        Librarian?
  transportManager TransportManager?
  receptionist     Receptionist?
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique

  users User[]
}

model School {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?  @unique
  address   String
  city      String?
  state     String?
  country   String?
  pincode   String?
  phone     String
  email     String
  logo      String?
  website   String?
  createdAt DateTime @default(now())

  users             User[]
  students          Student[]
  teachers          Teacher[]
  principals        Principal[]
  accountants       Accountant[]
  librarians        Librarian[]
  transportManagers TransportManager[]
  receptionists     Receptionist[]
  classes           Class[]
}

//student management
model Student {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  schoolId          Int
  classId           Int
  admissionNo       String   @unique
  rollNumber        String?
  section           String?
  fatherName        String?
  motherName        String?
  parentPhone       String?
  parentEmail       String?
  admissionDate     DateTime @default(now())
  transportRequired Boolean  @default(false)
  photo             String?
  qrCode            String?
  createdAt         DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school      School       @relation(fields: [schoolId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  parents     Parent[]

  attendance  Attendance[]
  fees        Fee[]
  results     Result[]
  certificates Certificate[]
}

// parent model
model Parent {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique
  occupation String?
  relation   String
  studentId  Int?

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student    Student? @relation(fields: [studentId], references: [id])
}

model Teacher {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  schoolId      Int?
  employeeId    String   @unique
  qualification String?
  experience    Int?
  subject       String?
  classAssigned String?
  joiningDate   DateTime @default(now())
  salary        Float?

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School?    @relation(fields: [schoolId], references: [id])
  subjects      Subject[]
  homeworks     Homework[]
  timetables    Timetable[]
}

model Principal {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  schoolId      Int
  employeeId    String   @unique
  qualification String?
  experience    Int?
  joiningDate   DateTime @default(now())
  department    String?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School   @relation(fields: [schoolId], references: [id])
}

model Accountant {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  schoolId      Int
  employeeId    String   @unique
  qualification String?
  experience    Int?
  joiningDate   DateTime @default(now())
  salary        Float?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School   @relation(fields: [schoolId], references: [id])
}

model Librarian {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  schoolId      Int
  employeeId    String   @unique
  qualification String?
  experience    Int?
  joiningDate   DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School   @relation(fields: [schoolId], references: [id])
}

model TransportManager {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  schoolId        Int
  employeeId      String   @unique
  vehicleAssigned String?
  routeAssigned   String?
  licenseNumber   String?
  joiningDate     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School   @relation(fields: [schoolId], references: [id])
}

model Receptionist {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  schoolId      Int
  employeeId    String   @unique
  joiningDate   DateTime @default(now())
  salary        Float?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School   @relation(fields: [schoolId], references: [id])
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String
  section  String
  schoolId Int

  school    School      @relation(fields: [schoolId], references: [id])
  students  Student[]
  timetables Timetable[]
}

model Subject {
  id        Int    @id @default(autoincrement())
  name      String
  code      String @unique
  teacherId Int?

  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  timetables Timetable[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  date      DateTime
  status    String

  student   Student  @relation(fields: [studentId], references: [id])
}

model Fee {
  id            Int      @id @default(autoincrement())
  studentId     Int
  amount        Float
  dueDate       DateTime
  paidAmount    Float    @default(0)
  status        String
  paymentMethod String?
  createdAt     DateTime @default(now())
  
  student       Student  @relation(fields: [studentId], references: [id])
}

model Exam {
  id       Int      @id @default(autoincrement())
  name     String
  examDate DateTime

  results  Result[]
}

model Result {
  id        Int     @id @default(autoincrement())
  studentId Int
  examId    Int
  marks     Float
  grade     String?

  student   Student @relation(fields: [studentId], references: [id])
  exam      Exam    @relation(fields: [examId], references: [id])
}

model Homework {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dueDate     DateTime
  attachment  String?
  teacherId   Int

  teacher     Teacher  @relation(fields: [teacherId], references: [id])
}

model Course {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  thumbnail   String?
  
  lectures    Lecture[]
}

model Lecture {
  id       Int    @id @default(autoincrement())
  courseId Int
  title    String
  videoUrl String

  course   Course @relation(fields: [courseId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String
  userId    Int?
  createdAt DateTime @default(now())
}

model Timetable {
  id        Int    @id @default(autoincrement())
  classId   Int
  subjectId Int
  teacherId Int
  day       String
  startTime String
  endTime   String

  class     Class   @relation(fields: [classId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}

//transport management
model Bus {
  id         Int    @id @default(autoincrement())
  busNumber  String
  driverName String
  route      String
  gpsDeviced String
}

//hostel management
model HostelRoom {
  id         Int    @id @default(autoincrement())
  roomNumber String
  capacity   Int
  occupied   Int    @default(0)
}

model Book {
  id       Int    @id @default(autoincrement())
  title    String
  author   String
  isbn     String @unique
  quantity Int
}

model Inventory {
  id       Int    @id @default(autoincrement())
  itemName String
  quantity Int
  category String
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  eventDate   DateTime
}

model Certificate {
  id        Int      @id @default(autoincrement())
  studentId Int
  type      String
  qrCode    String?
  issueDate DateTime

  student   Student  @relation(fields: [studentId], references: [id])
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  createdAt DateTime @default(now())
}